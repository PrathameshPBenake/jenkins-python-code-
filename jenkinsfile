pipeline {
    agent any

    stages {
        stage('Deploy to NGINX') {
            steps {
                bat '''
                del /Q C:\\nginx\\html\\*
                xcopy /E /I /Y "%WORKSPACE%\\*" "C:\\nginx\\html\\"
                taskkill /F /IM nginx.exe
                cd C:\\nginx
                start nginx
                '''
            }
        }
    }
}
