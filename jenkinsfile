pipeline {
    agent any

    stages {
        stage('Build Docker Image') {
            steps {
                bat 'docker build -t my-nginx-app .'
            }
        }

        stage('Remove Old Container') {
            steps {
                bat '''
                docker rm -f my-nginx-container 2>nul
                exit /b 0
                '''
            }
        }

        stage('Run New Container') {
            steps {
                bat '''
                docker run -d -p 8081:80 --name my-nginx-container my-nginx-app
                '''
            }
        }
    }
}
